*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Sidecar files (ThermoRawFileParser generates these)
*.cui

# Virtual environments
.venv/
venv/
.env
.env.*

# Data directory — test fixtures, not tracked
data/*
!data/README.md
!data/test-pdv/**
!data/test-mock/
!data/test-mock/**

# Tools — downloaded binaries, not tracked
tools/**
!tools/README.md
!tools/xvfb/
!tools/xvfb/bin/
!tools/xvfb/bin/Xvfb
!tools/xvfb/lib/
!tools/xvfb/lib/*.so*
!tools/xvfb/CHECKSUMS.sha256
# PDV 2.1.2 has no public release: its JAR is committed (lib/ and resources/
# are symlinks to the downloaded PDV 2.2.3 and stay ignored).
!tools/PDV-2.1.2/
!tools/PDV-2.1.2/PDV-2.1.2.jar
!tools/PDV-2.1.2/NOTICE

# Pipeline outputs (user-generated, not committed)
output/**

# Colleagues' reference implementation — a symlink into another user's home
# directory (/home/labs/pilpel/elizabev/TARSUS). Read-only, not ours to
# redistribute, and meaningless outside this cluster. Never commit it.
TARSUS_elizabev

# Philosopher/FragPipe artifacts
.meta/
*-decoys-*.fas
*.mzBIN

# Agent workspace (session continuity, not for publishing)
.agents/
.memory/progress.md

# Agent/IDE work notes (not for publishing)
.superpowers/
.claude/

# Internal reference docs (contains cluster-internal paths)
.context/reference-pipeline.md

# macOS
.DS_Store

# Philosopher decoy DBs (regenerated; formerly double-decoyed, see D-062)
*.fas

